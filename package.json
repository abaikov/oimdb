{
  "name": "oimdb",
  "version": "2.0.0",
  "description": "Deprecated umbrella package for OIMDB. Use @oimdb/core for collections, indexes, selectors, and DX factories.",
  "keywords": [
    "typescript",
    "library",
    "oim",
    "database",
    "oimdb",
    "state-management",
    "state-manager"
  ],
  "type": "module",
  "workspaces": [
    "packages/*",
    "website"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "deprecated": "This package has been split into scoped packages. Use @oimdb/core for collections, indexes, selectors, and DX factories.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/oimdb.git"
  },
  "bugs": {
    "url": "https://github.com/abaikov/oimdb/issues"
  },
  "homepage": "https://abaikov.github.io/oimdb/",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "build:llms-full": "node scripts/build-llms-full.mjs",
    "build:core": "cd packages/core && npm run build",
    "build:react": "cd packages/react && npm run build",
    "build:persist": "cd packages/persist && npm run build",
    "build:persist-memory": "cd packages/persist-memory && npm run build",
    "build:persist-localstorage": "cd packages/persist-localstorage && npm run build",
    "build:persist-idb": "cd packages/persist-idb && npm run build",
    "build:persist-async-kv": "cd packages/persist-async-kv && npm run build",
    "build:persist-json": "cd packages/persist-json && npm run build",
    "build:snapshot-manager": "cd packages/snapshot-manager && npm run build",
    "build:redux-adapter": "cd packages/redux-adapter && npm run build",
    "build:devtools": "cd packages/devtools && npm run build",
    "build:mcp": "cd packages/mcp && npm run build",
    "build:packages": "npm run build --workspace @oimdb/core --workspace @oimdb/persist --workspace @oimdb/persist-memory --workspace @oimdb/devtools && npm --workspaces --if-present run build",
    "bench": "npm run bench --workspace @oimdb/bench",
    "type-check": "npm --workspaces --if-present run type-check",
    "clones": "jscpd packages",
    "check:docs": "node scripts/check-docs-examples.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "size:write": "node scripts/check-bundle-size.mjs --write",
    "verify": "npm run lint && npm run clones && npm run check-structure && npm run build:core && npm run type-check && npm run check:docs && npm run size && npm run coverage && npm test --workspace @oimdb/bench && npm run build:packages",
    "check-structure": "npm --workspaces --if-present run check-structure",
    "prepublishOnly": "npm run verify && npm run build",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/tests/**/*.{ts,tsx}\" \"packages/*/bench/**/*.ts\" \"packages/*/scripts/**/*.ts\" --max-warnings 0 --no-error-on-unmatched-pattern",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.ts\" \"packages/core/src/**/*.ts\" \"packages/react/src/**/*.ts\"",
    "clean": "rimraf dist packages/core/dist packages/react/dist packages/async/dist packages/persist/dist packages/persist-memory/dist packages/persist-localstorage/dist packages/persist-idb/dist packages/persist-async-kv/dist packages/persist-json/dist packages/snapshot-manager/dist packages/redux-adapter/dist",
    "docs:dev": "npm run start --workspace website",
    "docs:build": "npm run build --workspace website",
    "docs:serve": "npm run serve --workspace website",
    "install:packages": "cd packages/core && npm install && cd ../react && npm install",
    "publish:core": "npm publish --workspace @oimdb/core --access public",
    "publish:react": "npm publish --workspace @oimdb/react --access public",
    "publish:async": "npm publish --workspace @oimdb/async --access public",
    "publish:persist": "npm publish --workspace @oimdb/persist --access public",
    "publish:persist-memory": "npm publish --workspace @oimdb/persist-memory --access public",
    "publish:persist-localstorage": "npm publish --workspace @oimdb/persist-localstorage --access public",
    "publish:persist-idb": "npm publish --workspace @oimdb/persist-idb --access public",
    "publish:persist-async-kv": "npm publish --workspace @oimdb/persist-async-kv --access public",
    "publish:persist-json": "npm publish --workspace @oimdb/persist-json --access public",
    "publish:snapshot-manager": "npm publish --workspace @oimdb/snapshot-manager --access public",
    "publish:redux-adapter": "npm publish --workspace @oimdb/redux-adapter --access public",
    "publish:devtools": "npm publish --workspace @oimdb/devtools --access public",
    "publish:mcp": "npm publish --workspace @oimdb/mcp --access public",
    "publish:bumped": "node scripts/publish-bumped.mjs",
    "publish:bumped:dry": "node scripts/publish-bumped.mjs --dry-run",
    "publish:all": "npm run publish:core && npm run publish:react && npm run publish:persist && npm run publish:persist-memory && npm run publish:persist-localstorage && npm run publish:persist-idb && npm run publish:persist-async-kv && npm run publish:persist-json && npm run publish:snapshot-manager && npm run publish:redux-adapter && npm run publish:devtools && npm run publish:mcp",
    "build:core-legacy": "cd packages/core-legacy && npm run build"
  },
  "files": [
    "dist"
  ],
  "lint-staged": {
    "{packages,src}/**/*.{ts,tsx}": [
      "eslint --max-warnings 0"
    ],
    "tsup.config.ts": [
      "eslint --max-warnings 0"
    ]
  },
  "dependencies": {
    "@oimdb/core": "^2.0.0"
  },
  "author": "Andrei Baikov",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.8.10",
    "@types/react": "^19.1.12",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jscpd": "^4.3.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.0.3",
    "react": "^19.1.1",
    "rimraf": "^5.0.5",
    "semver": "^7.7.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.4",
    "typescript": "^5.2.2"
  }
}
