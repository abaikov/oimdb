{
  "name": "@oimdb/exodra",
  "version": "2.0.2",
  "description": "Exodra plugin for @oimdb/core: one-line tracked effects, slot watches and bucket lists that keep their nodes.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "oimdbRelease": {
    "publish": true
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --clean --external @oimdb/core --external @exodra/core --external @exodra/dom --external @exodra/context",
    "test": "jest",
    "type-check": "tsc --noEmit -p tsconfig.all.json",
    "clean": "rimraf dist",
    "prepack": "node -e \"const {copyFileSync,existsSync}=require('fs');if(existsSync('../../llms.txt'))copyFileSync('../../llms.txt','llms.txt')\"",
    "prepublishOnly": "npm run type-check && npm test && npm run build"
  },
  "peerDependencies": {
    "@exodra/context": "^0.3.0",
    "@exodra/core": "^0.4.0",
    "@exodra/dom": "^0.4.0",
    "@oimdb/core": "^4.9.0"
  },
  "license": "MIT",
  "author": "Andrei Baikov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/oimdb.git"
  },
  "bugs": {
    "url": "https://github.com/abaikov/oimdb/issues"
  },
  "homepage": "https://github.com/abaikov/oimdb#readme",
  "keywords": ["oimdb", "exodra", "reactive", "typescript", "state-management"],
  "devDependencies": {
    "@exodra/context": "^0.3.0",
    "@exodra/core": "^0.4.0",
    "@exodra/dom": "^0.4.0",
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.2.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "llms.txt", "README.md"]
}
