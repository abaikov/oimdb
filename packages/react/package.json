{
  "name": "@oimdb/react",
  "version": "3.0.0",
  "description": "React bindings for @oimdb/core: hooks that subscribe through OIMChannel and read the slots it wakes.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "oimdbRelease": {
    "publish": true
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --clean --external react",
    "test": "jest",
    "type-check": "tsc --noEmit -p tsconfig.all.json",
    "clean": "rimraf dist",
    "prepack": "node -e \"const {copyFileSync,existsSync}=require('fs');if(existsSync('../../llms.txt'))copyFileSync('../../llms.txt','llms.txt')\"",
    "prepublishOnly": "npm run type-check && npm test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@oimdb/core": "^4.0.0"
  },
  "license": "MIT",
  "author": "Andrei Baikov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/oimdb.git"
  },
  "bugs": {
    "url": "https://github.com/abaikov/oimdb/issues"
  },
  "homepage": "https://github.com/abaikov/oimdb#readme",
  "keywords": [
    "oimdb",
    "in-memory",
    "database",
    "reactive",
    "typescript",
    "type-safe",
    "indices",
    "subscriptions",
    "event-processing",
    "state-management"
  ],
  "devDependencies": {
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^29.5.8",
    "@types/react": "^18.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.2.2",
    "react": "^18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "llms.txt",
    "README.md"
  ]
}
