{
  "name": "@oimdb/async",
  "version": "2.3.0",
  "description": "DEPRECATED \u2014 do not use. Async collections/indexes; use @oimdb/core (plus @oimdb/persist for I/O) instead.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/oimdb.git"
  },
  "bugs": {
    "url": "https://github.com/abaikov/oimdb/issues"
  },
  "homepage": "https://github.com/abaikov/oimdb#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts --tsconfig tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run type-check && npm run build"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@oimdb/core": "^3.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.2.2",
    "rimraf": "^5.0.5"
  },
  "keywords": [
    "oimdb",
    "deprecated"
  ],
  "author": "Andrei Baikov",
  "license": "MIT",
  "deprecated": "@oimdb/async is deprecated and exports nothing. Keep asynchrony outside the store: await your I/O, then write into a normal @oimdb/core collection. For load/save use @oimdb/persist."
}
