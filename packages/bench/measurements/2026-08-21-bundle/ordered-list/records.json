    "findings": [
        {
            "id": "control-tree-shaking",
            "isControl": true,
            "question": "Is the bundler dropping code nothing reaches?",
            "fromLabel": "everything (minified)",
            "toLabel": "database-only (minified)",
            "fromBytes": 44226,
            "toBytes": 9477,
            "fromGzipBytes": 12433,
            "toGzipBytes": 3043,
            "deltaBytes": -34749,
            "deltaGzipBytes": -9390,
            "requirement": "a database alone under 60% of the whole surface",
            "holds": true,
            "caveat": "An application that constructs a database and touches nothing else must not carry the hundred modules of the published surface. If this reads near 1.00 the bundler kept everything, every arm below is the same bundle under four names, and every difference in this report is a rounding of zero — including the one it was written to settle, which would then read as \"the ordered-list diff is free\". That is a conclusion this project would enjoy and has not earned, so it voids the report instead."
        },
        {
            "id": "control-minified",
            "isControl": true,
            "question": "Is the minifier running at all?",
            "fromLabel": "everything (bundled, not minified)",
            "toLabel": "everything (minified)",
            "fromBytes": 217878,
            "toBytes": 44226,
            "fromGzipBytes": 61981,
            "toGzipBytes": 12433,
            "deltaBytes": -173652,
            "deltaGzipBytes": -49548,
            "requirement": "minified under 70% of the same bundle unminified",
            "holds": true,
            "caveat": "This package ships roughly as many bytes of comment as of code, and a claim about what is SHIPPED is a claim about output a minifier has already been through. If these two numbers are equal the minifier did nothing, and every kilobyte below is mostly prose — in the direction that flatters the decision the claim defends, which is the one to guard hardest."
        },
        {
            "id": "ordered-list-diff",
            "isControl": false,
            "question": "What does asking for an ordered list add to an application that was not going to have one?",
            "fromLabel": "without-ordered-list (minified)",
            "toLabel": "with-ordered-list (minified)",
            "fromBytes": 26457,
            "toBytes": 28064,
            "fromGzipBytes": 7895,
            "toGzipBytes": 8550,
            "deltaBytes": 1607,
            "deltaGzipBytes": 655,
            "share": 0.036336091891647444,
            "gzipShare": 0.052682377543633876,
            "requirement": "none — this row is the measurement, not an attestation",
            "holds": true,
            "caveat": "THIS IS THE NUMBER EIGHT SITES IN THIS REPOSITORY QUOTE AS \"some 2.7 KB — around 4% of the package\", and it is the whole quantitative half of the argument for `createOrderedCommands` being a free function rather than a method on `OIMDB`. Read it as the cost a METHOD would have imposed: every consumer imports `OIMDB`, a bundler cannot drop a class's methods one at a time, so under that design the arm on the left would have carried the same bytes as the arm on the right. WHAT THE DIFFERENCE CONTAINS: the `createOrderedCommands` module, the `diffOrderedList` module it pins, and the three-line call site — the call site is NOT subtracted, because an application that renders an ordered list writes one under either design, so treating this as the cost of the modules alone over-states it by a few dozen bytes. THE DENOMINATOR is every name the package exports with nothing droppable, which is the largest one available and therefore the least flattering to the percentage."
        }
    ]
}
