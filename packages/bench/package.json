{
  "name": "@oimdb/bench",
  "version": "0.0.0",
  "private": true,
  "description": "Comparative benchmarks: OIMDB against in-memory stores, reactive state managers and atomic libraries",
  "type": "module",
  "scripts": {
    "bench": "node --import tsx src/bench.ts",
    "bench:status": "node --import tsx src/bench.ts status",
    "bench:next": "node --import tsx src/bench.ts next",
    "bench:night": "caffeinate -i node --import tsx src/bench.ts next --budget 6h --wait",
    "bench:verify": "node --import tsx src/bench.ts verify",
    "bench:report": "node --import tsx src/bench.ts report",
    "bench:publish": "node --import tsx src/bench.ts publish",
    "audit": "node --import tsx src/audit.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "duel": "node --import tsx src/duel.ts",
    "duel:list": "node --import tsx src/duel.ts --list",
    "price": "node --import tsx src/price.ts",
    "price:list": "node --import tsx src/price.ts --list",
    "price:publish": "node --import tsx src/price/publishPriceRecords.ts",
    "alternatives": "node --import tsx src/alternatives.ts",
    "alternatives:list": "node --import tsx src/alternatives.ts --list",
    "retained": "node --import tsx src/retained.ts",
    "retained:list": "node --import tsx src/retained.ts --list",
    "bundle": "node --import tsx src/bundle.ts",
    "bundle:list": "node --import tsx src/bundle.ts --list",
    "citations": "node scripts/dead-citations.mjs",
    "lines": "node --import tsx src/lines.ts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@legendapp/state": "^2.1.15",
    "@preact/signals-core": "^1.14.4",
    "@reduxjs/toolkit": "^2.13.0",
    "@signaldb/core": "^1.8.1",
    "@tanstack/db": "^0.15.0",
    "@tanstack/store": "^0.11.2",
    "@tanstack/table-core": "^9.3.1",
    "@vue/reactivity": "^3.5.43",
    "@xstate/store": "^4.2.3",
    "alien-signals": "^3.2.1",
    "effector": "^23.2.2",
    "esbuild": "^0.25.9",
    "jotai": "^3.0.1",
    "jotai-family": "^1.1.0",
    "lokijs": "^1.5.12",
    "mobx": "^7.0.6",
    "nanostores": "^1.5.5",
    "react-redux": "^9.2.0",
    "reselect": "^5.3.0",
    "solid-js": "^1.9.15",
    "tinybase": "^10.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.2.2",
    "valtio": "^2.3.2",
    "yaml": "^2.9.0",
    "zustand": "^5.0.15"
  }
}
