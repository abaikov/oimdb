{
  "name": "@oimdb/mcp",
  "version": "2.0.0",
  "description": "MCP server and CDP inspector for OIMDB \u2014 connects AI assistants to live browser state",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "oimdbRelease": {
    "publish": true
  },
  "bin": {
    "oimdb-mcp": "bin/oimdb-mcp.cjs"
  },
  "files": [
    "dist",
    "bin",
    "ui"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts --tsconfig tsconfig.build.json",
    "dev": "tsup --config tsup.config.ts --tsconfig tsconfig.build.json --watch",
    "type-check": "tsc --noEmit -p tsconfig.tests.json",
    "prepublishOnly": "npm run type-check && npm run build",
    "test": "jest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.18.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "tsup": "^8.0.0",
    "typescript": "^5.2.2",
    "@types/jest": "^29.5.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1"
  },
  "keywords": [
    "oimdb",
    "mcp",
    "devtools",
    "debug",
    "cdp",
    "ai"
  ],
  "author": "Andrei Baikov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/oimdb.git",
    "directory": "packages/mcp"
  }
}
