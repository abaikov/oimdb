{
  "name": "@oimdb/mcp",
  "version": "3.1.0",
  "description": "MCP server for OIMDB — gives AI assistants the oimdb_inspect, oimdb_dump, oimdb_collection and oimdb_computed tools over @oimdb/cli",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "oimdbRelease": {
    "publish": true
  },
  "bin": {
    "oimdb-mcp": "bin/oimdb-mcp.cjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts --tsconfig tsconfig.build.json",
    "dev": "tsup --config tsup.config.ts --tsconfig tsconfig.build.json --watch",
    "type-check": "tsc --noEmit -p tsconfig.tests.json",
    "prepublishOnly": "npm run type-check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "@oimdb/cli": "^1.2.0"
  },
  "devDependencies": {
    "@oimdb/cli": "*",
    "tsup": "^8.0.0",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "oimdb",
    "mcp",
    "devtools",
    "debug",
    "cdp",
    "ai"
  ],
  "author": "Andrei Baikov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/oimdb.git",
    "directory": "packages/mcp"
  }
}
