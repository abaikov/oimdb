{
  "name": "@oimdb/devtools",
  "version": "2.0.0",
  "description": "Debug registry for OIMDB: name collections and indexes, inspect runtime state, assist AI development",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "oimdbRelease": {
    "publish": true
  },
  "files": [
    "dist",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts --tsconfig tsconfig.build.json",
    "dev": "tsup --config tsup.config.ts --tsconfig tsconfig.build.json --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit -p tsconfig.tests.json",
    "prepack": "node -e \"const {copyFileSync}=require('fs');copyFileSync('../../llms.txt','llms.txt');copyFileSync('../../llms-full.txt','llms-full.txt')\"",
    "prepublishOnly": "npm run type-check && npm test && npm run build"
  },
  "peerDependencies": {
    "@oimdb/core": "^4.0.0"
  },
  "devDependencies": {
    "@oimdb/core": "*",
    "@types/jest": "^29.5.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "oimdb",
    "devtools",
    "debug",
    "registry",
    "reactive",
    "collection"
  ],
  "author": "Andrei Baikov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/oimdb.git",
    "directory": "packages/devtools"
  }
}
