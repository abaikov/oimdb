{
  "name": "@oimdb/persist-localstorage",
  "version": "4.0.0",
  "description": "localStorage persistence backend for @oimdb/persist (browser)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaikov/oimdb.git",
    "directory": "packages/persist-localstorage"
  },
  "bugs": {
    "url": "https://github.com/abaikov/oimdb/issues"
  },
  "homepage": "https://github.com/abaikov/oimdb#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "oimdbRelease": {
    "publish": true
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts --tsconfig tsconfig.build.json",
    "test": "jest",
    "type-check": "tsc --noEmit -p tsconfig.all.json",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run type-check && npm test && npm run build"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@oimdb/core": "^4.0.0",
    "@oimdb/persist": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.2.2",
    "rimraf": "^5.0.5"
  },
  "keywords": [
    "oimdb",
    "persist",
    "localstorage",
    "browser",
    "storage",
    "typescript"
  ],
  "author": "Andrei Baikov",
  "license": "MIT"
}
